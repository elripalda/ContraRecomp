#!/bin/sh
# ContraRecomp AppImage entry point.
#
# The game keeps config.ini, rom.cfg (your ROM's location) and saves beside its
# program, and an AppImage is read-only. So the program is copied once per
# version to ~/.local/share/ContraRecomp and run from there; your settings and
# saves in that folder are kept across updates.
HERE="$(dirname "$(readlink -f "$0")")"
DATA="${CONTRARECOMP_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/ContraRecomp}"
VERSION="$(cat "$HERE/VERSION")"

if [ "$(cat "$DATA/VERSION" 2>/dev/null)" != "$VERSION" ] || [ ! -x "$DATA/bin/contrarecomp" ]; then
    mkdir -p "$DATA/bin" || exit 1
    rm -rf "$DATA/bin/assets" "$DATA/lib"
    cp -R "$HERE/usr/lib" "$DATA/lib" &&
    cp -R "$HERE/usr/bin/assets" "$DATA/bin/assets" &&
    cp -f "$HERE/usr/bin/contrarecomp" "$DATA/bin/contrarecomp.new" &&
    mv -f "$DATA/bin/contrarecomp.new" "$DATA/bin/contrarecomp" &&
    cp -f "$HERE/VERSION" "$DATA/VERSION" || exit 1
fi

cd "$DATA/bin" || exit 1
exec "$DATA/bin/contrarecomp" "$@"
